# Copy to rochade.prod.env (gitignored) for a deployment, or to .env locally.
# Compose interpolates it on the workstation, so it never has to be on the box.
# The defaults shown are what a local `docker compose up` uses.

# Postgres password, used by the database, the API and Zitadel alike.
# Required in prod; baked into the data volume on first start.
POSTGRES_PASSWORD=change-me

# Where the app is, as the browser sees it: the QR codes and the sign-in
# redirect are built from it.
ROCHADE_PUBLIC_URL=http://localhost:8092

# Where Zitadel is, as the browser sees it. Four views of the same URL that
# must agree: in prod https://auth.example.com / auth.example.com / 443 / true.
AUTH_URL=http://localhost:8093
AUTH_DOMAIN=localhost
AUTH_PORT=8093
AUTH_SCHEME=http
AUTH_SECURE=false

# Exactly 32 characters. Zitadel encrypts its secrets with it; losing it
# loses them. Required in prod.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

# The first arbiter account, created on Zitadel's first start only. More
# arbiters are added in Zitadel's console at AUTH_URL/ui/console.
ZITADEL_ADMIN_EMAIL=admin@rochade.localhost
ZITADEL_ADMIN_PASSWORD=Password1!

# Take any bearer that is not a JWT as the staff subject, unverified. On
# locally so the smoke and browser scripts can sign in; off in prod.
ROCHADE_DEV_AUTH_ENABLED=false

# Let a phone join by typing the tournament's six-character code.
ROCHADE_DEVICE_JOIN_ENABLED=false

# Local runs only: the host port the stack is published on.
ROCHADE_WEB_PORT=8092

# Deployment only: where the state directories live on the box, and the
# docker network the shared proxy is on (see deploy/README.md).
ROCHADE_DATA_DIR=/home/roman/stacks/rochade/data
PROXY_NETWORK=proxy

# Outgoing mail for Zitadel: invitations, passkey registration links and
# password resets. Scaleway Transactional Email on rochade.app: the user is
# the Scaleway project id and the password an API key with the
# TransactionalEmailEmailSmtpCreate permission (IAM application
# "rochade-zitadel"; its key expires 2027-09-09). Unset locally.
SMTP_HOST=smtp.tem.scw.cloud:465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mail.rochade.app
SMTP_FROM_NAME=Rochade
SMTP_TLS=true
