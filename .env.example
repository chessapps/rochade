# Copy to seebach.prod.env (gitignored) for a deployment, or to .env locally.
# Compose interpolates it on the workstation, so it never has to be on the box.

# Postgres password, used by the database and the API alike. Required in prod.
POSTGRES_PASSWORD=change-me

# Take any bearer token as the staff subject, unverified. Off by default in a
# deployment; on until Zitadel is in front of this. See deploy/README.md.
SEEBACH_DEV_AUTH_ENABLED=true

# Let a phone join by typing the tournament's six-character code.
SEEBACH_DEVICE_JOIN_ENABLED=true

# Real auth: set the issuer and turn SEEBACH_DEV_AUTH_ENABLED off.
SEEBACH_OIDC_ISSUER=

# Local runs only: the host port the stack is published on.
SEEBACH_WEB_PORT=8092
