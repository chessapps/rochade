{
	admin off
	auto_https off
}

# The app: the three frontends and the API on one origin.
:8080 {
	# In a deployment a shared Caddy in front of this one terminates TLS and
	# sets X-Forwarded-Proto/Host. Trust those from the docker network, or
	# they get replaced with plain http here and the API redirects to http://.
	handle /api/* {
		reverse_proxy api:8000 {
			trusted_proxies private_ranges
		}
	}
	handle /health {
		reverse_proxy api:8000 {
			trusted_proxies private_ranges
		}
	}

	handle /admin* {
		uri strip_prefix /admin
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# The public view: readable by anyone, published tournaments only.
	handle /live* {
		uri strip_prefix /live
		root * /srv/live
		try_files {path} /index.html
		file_server
	}

	# Everything else is the hall app, so the QR code can point at
	# /hall/<tournament-id> and land on it directly.
	handle {
		root * /srv/hall
		try_files {path} /index.html
		file_server
	}
}

# Zitadel, on its own hostname (AUTH_URL): the login UI is a second
# container under one path, everything else is the core over h2c.
:8081 {
	reverse_proxy /ui/v2/login/* zitadel-login:3000 {
		trusted_proxies private_ranges
	}
	reverse_proxy h2c://zitadel:8080 {
		trusted_proxies private_ranges
		# A known hang with gRPC-web through Caddy; Zitadel's docs say drop it.
		header_up -TE
	}
}
