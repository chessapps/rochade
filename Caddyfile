{
	admin off
	auto_https off
}

:8080 {
	# In a deployment a shared Caddy in front of this one terminates TLS and
	# sets X-Forwarded-Proto/Host. Trust those from the docker network, or
	# they get replaced with plain http here and the API redirects to http://.
	handle /api/* {
		reverse_proxy api:8000 {
			trusted_proxies private_ranges
		}
	}
	handle /health {
		reverse_proxy api:8000 {
			trusted_proxies private_ranges
		}
	}

	handle /admin* {
		uri strip_prefix /admin
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# Everything else is the hall app, so the QR code can point at
	# /hall/<tournament-id> and land on it directly.
	handle {
		root * /srv/hall
		try_files {path} /index.html
		file_server
	}
}
