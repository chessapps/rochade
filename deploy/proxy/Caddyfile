# One site block per stack. The upstream is the container_name the stack
# gives its public-facing service, resolvable because both sit on the
# `proxy` docker network. Certificates come from Let's Encrypt on their own.
#
# After editing:
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}
}

# The app: hall, arbiter app and API on one origin.
seebach.example.com {
	encode gzip
	reverse_proxy seebach-web:8080
}

# Zitadel, the arbiters' sign-in. The stack's own Caddy fans this out to the
# core and the login UI, so one plain upstream is enough here.
auth.example.com {
	reverse_proxy seebach-web:8081
}
